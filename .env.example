# Copy this file to .env and fill in a real value. Never commit .env.

# Connection string for the hosted Supabase Postgres database. Read by
# src/poker_analyzer/db/connection.py (via python-dotenv), used by init_db.py
# and the CLI's `ingest` command. Tables live in a dedicated "poker_analyzer"
# schema, not "public" (see connection.py's module docstring for why).
#
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# If the password contains special characters (@, :, /, etc.), percent-encode
# them (e.g. "@" -> "%40") or the connection string won't parse correctly.
SUPABASE_DB_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres
